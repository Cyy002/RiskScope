# Used by deploy/riskscope.sh|.ps1 (export these in your shell) and compose.yml.
# Do NOT copy a host-style 127.0.0.1 URL into a bridge-network container: inside
# the container 127.0.0.1 is the container itself, not your Ollama.
# Allowed hosts (app/config.py): localhost, 127.0.0.1, ::1, host.containers.internal.

# DEFAULT for Podman containers on macOS / Windows / Linux (Ollama on the host;
# on Windows/Linux Ollama must listen on 0.0.0.0, i.e. OLLAMA_HOST=0.0.0.0):
OLLAMA_URL=http://host.containers.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_REPLY_TIMEOUT_SECONDS=120

# Only for running the app directly with Python on the host (no container):
#   OLLAMA_URL=http://127.0.0.1:11434
# (If OLLAMA_URL is unset the app runs deterministic-only, with NO model.)
# Linux alternative: RS_HOST_NETWORK=1 with OLLAMA_URL=http://127.0.0.1:11434
