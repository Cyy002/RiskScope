FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    AGENT_DB_PATH=/app/runtime/agent.sqlite3 \
    AGENT_CREDENTIALS_PATH=/app/runtime/demo_credentials.json
WORKDIR /app
COPY requirements.txt requirements-langgraph.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-langgraph.txt
COPY app ./app
COPY scripts ./scripts
COPY data ./data
RUN mkdir -p /app/runtime && useradd -u 10001 -m risk && chown -R risk:risk /app/runtime
USER risk
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000"]
