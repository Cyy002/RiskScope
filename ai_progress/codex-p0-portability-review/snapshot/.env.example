# Copy to .env (or export these in your shell) before starting RiskScope.
# Never commit a real .env -- it is already covered by .gitignore.

# Local (non-container) run on this Mac: the Ollama server is reachable at
# 127.0.0.1. This is the default app/config.py already falls back to if these
# vars are unset, so setting them explicitly here is just for clarity.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Podman / container run: 127.0.0.1 INSIDE the container is the container
# itself, not the Mac host -- it will never reach the host's Ollama. Podman's
# host-gateway DNS name reaches the host instead, and is already the only
# non-loopback hostname app/config.py's local_ollama_url() accepts:
#
#   OLLAMA_URL=http://host.containers.internal:11434
#
# compose.yml already defaults to this value for the `riskscope` service, so
# you normally don't need to set it yourself for `podman compose up`.
